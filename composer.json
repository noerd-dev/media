{
    "name": "noerd/media",
    "description": "Media module for noerd platform",
    "type": "library",
    "version": "v0.3.0",
	"license": "proprietary",
	"require": {
        "laravel/framework": "^12.0 || ^13.0",
        "noerd/noerd": "^0.10.0",
        "intervention/image": "^3.11",
        "barryvdh/laravel-dompdf": "^3.1"
    },
    "suggest": {
        "ext-imagick": "Legacy fallback for PDF thumbnail rasterization. Not needed when the Ghostscript binary (gs) is installed."
    },
    "autoload": {
        "psr-4": {
            "Noerd\\Media\\": "src/",
            "Noerd\\Media\\Tests\\": "tests/",
            "Noerd\\Media\\Database\\Factories\\": "database/factories/",
            "Noerd\\Media\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Noerd\\Media\\Providers\\MediaServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable"
}
